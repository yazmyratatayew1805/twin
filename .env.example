# Скопируйте в .env.local и заполните. Никогда не коммитьте .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — только сервер! Не добавляйте префикс NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Google Gemini (бесплатный тариф): объяснения пар, красные флаги, эмбеддинги «идеального дня».
# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Необязательно: модели и дневные лимиты (по умолчанию gemini-3.5-flash-lite, gemini-embedding-2, 900/900).
# GEMINI_TEXT_MODEL=
# GEMINI_EMBEDDING_MODEL=
# GEMINI_DAILY_TEXT_LIMIT=
# GEMINI_DAILY_EMBED_LIMIT=

# Публичный адрес сайта (для ссылок во входе по email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase CLI (link / db push). Только локально, в Vercel не нужны.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
