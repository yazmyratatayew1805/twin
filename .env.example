# Скопируйте в .env.local и заполните. Никогда не коммитьте .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — только сервер! Не добавляйте префикс NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Claude Haiku 4.5 — объяснения пар и красные флаги
ANTHROPIC_API_KEY=
# OpenAI text-embedding-3-small — эмбеддинг «идеального дня»
OPENAI_API_KEY=

# Публичный адрес сайта (для ссылок во входе по email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase CLI (link / db push). Только локально, в Vercel не нужны.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
